+/*
+ * SpectrumJetson: packets per isochronous URB (0 = the stock UVC_MAX_PACKETS, 32).
+ * The driver sees a URB's packets only when the whole URB completes, so with 32
+ * packets of 125 us a frame's last packet waits up to 4 ms (2 ms on average)
+ * before the frame is handed over, and first-packet timestamps land on 4 ms
+ * steps. Fewer packets per URB: lower latency, more (small) interrupts.
+ * Writable at run time (root): applies when a camera next starts streaming.
+ */
+static unsigned int uvc_urb_packets;
+module_param_named(urb_packets, uvc_urb_packets, uint, 0644);
+MODULE_PARM_DESC(urb_packets, "Packets per isochronous URB (0 = 32, the stock size)");
