+// SpectrumJetson: BlobDiff, but each block appends only its non-empty points to `result`,
+// counting them in `*num_result` (zeroed before the launch). The same points as BlobDiff followed
+// by DeviceSelect::If(NonZero), in a different order: blocks and threads append as they finish.
+// Nothing downstream depends on the order within a blob pair except the angle sort of the
+// selected points, which now sorts on the whole key (see Detect), so the detections are identical.
+template <size_t kBlockWidth, size_t kBlockHeight>
+__global__ void BlobDiffCompact(const uint8_t* thresholded_image,
+                                const uint32_t* blobs,
+                                const uint32_t* union_markers_size,
+                                QuadBoundaryPoint* result, int* num_result,
+                                apriltag_size_t width, apriltag_size_t height) {
+  __shared__ uint32_t temp_blob_storage[kBlockWidth * kBlockHeight];
+  __shared__ uint8_t temp_image_storage[kBlockWidth * kBlockHeight];
+  __shared__ int block_count;
+  __shared__ int block_base;
+
+  // Every thread reaches both __syncthreads(), so nothing returns early.
+  const uint x = blockIdx.x * (blockDim.x - 2) + threadIdx.x;
+  const uint y = blockIdx.y * (blockDim.y - 1) + threadIdx.y;
+  const bool loaded = x < width && y < height && y != 0;
+  const uint thread_linear_index = threadIdx.x + blockDim.x * threadIdx.y;
+
+  uint32_t rep0 = 0;
+  uint8_t v0 = 127;
+  if (loaded) {
+    rep0 = temp_blob_storage[thread_linear_index] = blobs[x + y * width];
+    v0 = temp_image_storage[thread_linear_index] =
+        thresholded_image[x + y * width];
+  }
+  if (thread_linear_index == 0) block_count = 0;
+  __syncthreads();
+
+  QuadBoundaryPoint points[4];
+  int n = 0;
+  // The same conditions as BlobDiff's returns.
+  if (loaded && threadIdx.x != 0 && threadIdx.x != blockDim.x - 1 &&
+      threadIdx.y != blockDim.y - 1 && x != width - 1 && y != height - 1 &&
+      v0 != 127 && union_markers_size[rep0] >= 25) {
+    uint32_t rep1 = 0;
+    uint8_t v1 = 0;
+    auto conn = [&](int dx, int dy, uint point_offset) {
+      const uint thread_linear_index1 =
+          (threadIdx.x + dx) + blockDim.x * (threadIdx.y + dy);
+      v1 = temp_image_storage[thread_linear_index1];
+      rep1 = temp_blob_storage[thread_linear_index1];
+      if (v0 + v1 == 255 && union_markers_size[rep1] >= 25) {
+        QuadBoundaryPoint cluster_id;
+        if (rep0 < rep1) {
+          cluster_id.set_rep1(rep1);
+          cluster_id.set_rep0(rep0);
+        } else {
+          cluster_id.set_rep1(rep0);
+          cluster_id.set_rep0(rep1);
+        }
+        cluster_id.set_base_xy(x, y);
+        cluster_id.set_dxy(point_offset);
+        cluster_id.set_black_to_white(v1 > v0);
+        points[n++] = cluster_id;
+      }
+    };
+    conn(1, 0, 0);
+    conn(1, 1, 1);
+    conn(0, 1, 2);
+    const uint32_t rep_block_2 = rep1;
+    const uint8_t v1_block_2 = v1;
+
+    const uint left_thread_linear_index1 =
+        threadIdx.x - 1 + blockDim.x * threadIdx.y;
+    const uint8_t v1_block_left = temp_image_storage[left_thread_linear_index1];
+    const uint32_t rep_block_left =
+        temp_blob_storage[left_thread_linear_index1];
+
+    // BlobDiff's dedup: connection 3 repeats the 0-2 connection.
+    const bool duplicate = v1_block_left != 127 && v1_block_2 != 127 &&
+                           v1_block_2 != v1_block_left && x != 1 &&
+                           union_markers_size[rep_block_left] >= 25 &&
+                           union_markers_size[rep_block_2] >= 25;
+    if (!duplicate) conn(-1, 1, 3);
+  }
+
+  const int offset = n > 0 ? atomicAdd(&block_count, n) : 0;
+  __syncthreads();
+  if (thread_linear_index == 0) {
+    block_base = block_count > 0 ? atomicAdd(num_result, block_count) : 0;
+  }
+  __syncthreads();
+  for (int i = 0; i < n; ++i) {
+    result[block_base + offset + i] = points[i];
+  }
+}
 
