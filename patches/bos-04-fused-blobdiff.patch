+// SpectrumJetson: BlobDiffCompact (below) writes only the boundary points, straight into the
+// compacted array, instead of BlobDiff writing all 4 slots of every pixel (~1M points, 8 MB at
+// 1280x800) and cub::DeviceSelect::If reading them all back to drop the empty ones. Those two
+// were 42% of the detector's GPU time (nsys, 2026-09-29). 971's own TODO asked for this. "0" in
+// /tmp/spectrum-971-fused-blobdiff goes back to BlobDiff + DeviceSelect (re-read every 2 s).
+bool SpectrumFusedBlobDiff() {
+  static SpectrumKnob knob("/tmp/spectrum-971-fused-blobdiff", 1);
+  return knob.Get() != 0;
 }
 
