+// An integer switch in a /tmp file, re-read at most every 2 s; `def` when the file is missing.
+class SpectrumKnob {
+ public:
+  SpectrumKnob(const char* path, int def) : path_(path), def_(def), value_(def) {}
+  int Get() {
+    std::lock_guard<std::mutex> lock(mu_);
+    const auto now = std::chrono::steady_clock::now();
+    if (now >= next_) {
+      next_ = now + std::chrono::seconds(2);
+      int v = def_;
+      if (FILE* f = std::fopen(path_, "r")) {
+        if (std::fscanf(f, "%d", &v) != 1) v = def_;
+        std::fclose(f);
+      }
+      value_ = v;
     }
-    on = v != 0;
+    return value_;
   }
-  return on || VLOG_IS_ON(1);
+
+ private:
+  const char* path_;
+  const int def_;
+  std::mutex mu_;
+  std::chrono::steady_clock::time_point next_{};
+  int value_;
+};
+
+bool SpectrumEventTiming() {
+  static SpectrumKnob knob("/tmp/spectrum-971-event-timing", 0);
+  return knob.Get() != 0 || VLOG_IS_ON(1);
+}
