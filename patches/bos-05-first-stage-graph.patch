+absl::Status GpuDetector::RecordFirstStageGraph(const uint8_t* image_device) {
+  image_device = FirstStageInput(image_device, gray_image_device_.get());
+  const int mwbd = tag_detector_->qtp.min_white_black_diff;
+  if (first_stage_exec_) cudaGraphExecDestroy(first_stage_exec_);
+  first_stage_exec_ = nullptr;
+  first_stage_failed_ = true;  // until it works
+  const size_t decimated_width = width_ / 2;
+  const size_t decimated_height = height_ / 2;
+  // The same steps, in the same order, as Detect() launches them one by one.
+  cudaError_t e = cudaStreamBeginCapture(stream_.get(), cudaStreamCaptureModeThreadLocal);
+  if (e != cudaSuccess) {
+    cudaGetLastError();
+    return absl::UnknownError(std::string("starting the first-stage graph failed: ") +
+                              cudaGetErrorString(e));
+  }
+  union_markers_size_device_.MemsetAsync(0u, &stream_);
+  threshold_->ThresholdAndDecimate(image_device, decimated_image_device_.get(),
+                                   thresholded_image_device_.get(), mwbd, &stream_);
+  LabelImage(ToGpuImage(thresholded_image_device_), ToGpuImage(union_markers_device_),
+             ToGpuImage(union_markers_size_device_), stream_.get());
+  num_compressed_union_marker_pair_device_.MemsetAsync(0, &stream_);
+  BlobDiffCompact<kBlobDiffBlockWidth, kBlobDiffBlockHeight>
+      <<<BlobDiffBlocks(decimated_width, decimated_height),
+         dim3(kBlobDiffBlockWidth, kBlobDiffBlockHeight, 1), 0, stream_.get()>>>(
+          thresholded_image_device_.get(), union_markers_device_.get(),
+          union_markers_size_device_.get(), compressed_union_marker_pair_device_.get(),
+          num_compressed_union_marker_pair_device_.get(), decimated_width, decimated_height);
