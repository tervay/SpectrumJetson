+      &num_compressed_union_marker_pair_host_, &stream_);
+  cudaGraph_t graph = nullptr;
+  e = cudaStreamEndCapture(stream_.get(), &graph);
+  if (e != cudaSuccess || !graph) {
+    cudaGetLastError();
+    return absl::UnknownError(std::string("recording the first-stage graph failed: ") +
+                              cudaGetErrorString(e));
+  }
+  e = cudaGraphInstantiate(&first_stage_exec_, graph, 0);
+  cudaGraphDestroy(graph);
+  if (e != cudaSuccess) {
+    cudaGetLastError();
+    first_stage_exec_ = nullptr;
+    return absl::UnknownError(std::string("instantiating the first-stage graph failed: ") +
+                              cudaGetErrorString(e));
+  }
+  first_stage_image_ = image_device;
+  first_stage_mwbd_ = mwbd;
+  first_stage_failed_ = false;
+  return absl::OkStatus();
