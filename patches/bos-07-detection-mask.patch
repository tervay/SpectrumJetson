 constexpr size_t kBlobDiffBlockWidth = 32;
 constexpr size_t kBlobDiffBlockHeight = 16;
 // BlobDiff's grid: overlap 1 on each side in x, and 1 in y.
+// SpectrumJetson (bos-07): pixels the mask ignores (0) become "no contrast" (127), which
+// BlobDiff skips, so nothing is found there.
+__global__ void ApplyMask(uint8_t* thresholded, const uint8_t* mask, size_t n) {
+  const size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x;
+  if (i < n && mask[i] == 0) thresholded[i] = 127;
+}
+void LaunchApplyMask(uint8_t* thresholded, const uint8_t* mask, size_t n, cudaStream_t stream) {
+  ApplyMask<<<(n + 255) / 256, 256, 0, stream>>>(thresholded, mask, n);
+}
+
 dim3 BlobDiffBlocks(size_t decimated_width, size_t decimated_height) {
   return dim3((decimated_width + kBlobDiffBlockWidth - 3) / (kBlobDiffBlockWidth - 2),
               (decimated_height + kBlobDiffBlockHeight - 2) / (kBlobDiffBlockHeight - 1), 1);
