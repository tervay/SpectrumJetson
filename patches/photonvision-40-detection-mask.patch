+const setMask = (m: DetectionMask) =>
+  useCameraSettingsStore().changeCurrentPipelineSetting({ detectionMask: m }, true);
+
+const modeItems = ["Off", "Ignore inside the boxes", "Search only inside the boxes"];
+const setMode = (mode: number) => setMask({ ...mask.value, mode });
+const removeBox = (i: number) => setMask({ ...mask.value, boxes: mask.value.boxes.filter((_, j) => j !== i) });
+const clearBoxes = () => setMask({ ...mask.value, boxes: [] });
+
+const drawing = computed<boolean>({
+  get: () => useStateStore().maskEditing,
+  set: (v) => (useStateStore().maskEditing = v)
