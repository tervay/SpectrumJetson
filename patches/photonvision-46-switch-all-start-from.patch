+            try {
+                // A deep copy: clone() would share the mask, HSV ranges and offset points.
+                copy =
+                        JacksonUtils.deserialize(
+                                JacksonUtils.serializeToString(source), CVPipelineSettings.class);
+            } catch (IOException e) {
+                throw new IllegalArgumentException("couldn't copy the pipeline: " + e.getMessage());
+            }
+            for (var field : copy.getClass().getFields()) {
+                int mods = field.getModifiers();
+                if (Modifier.isStatic(mods) || Modifier.isFinal(mods)) continue;
+                String name = field.getName();
+                if (name.equals("pipelineIndex") || name.equals("pipelineNickname")) continue;
+                if (!sourceIsThisCamera && CAMERA_OWN_FIELDS.contains(name)) continue;
+                if (!sourceIsThisCamera && !sameVideoModes && name.equals("cameraVideoModeIndex")) continue;
+                try {
+                    field.set(added, field.get(copy));
+                } catch (IllegalAccessException e) {
+                    logger.error("Could not copy " + name, e);
+                }
+            }
+        }
+        int index = pipelineManager.getPipelineNicknames().indexOf(nickname);
+        logger.info(
+                "Created pipeline "
+                        + index
+                        + " '"
+                        + nickname
+                        + "'"
