+package org.photonvision.vision.processes;
+
+import java.lang.management.ManagementFactory;
+import org.photonvision.common.dataflow.networktables.NetworkTablesManager;
+import org.photonvision.common.logging.LogGroup;
+import org.photonvision.common.logging.Logger;
+
+/**
+ * SpectrumJetson (photonvision-49): while connected to a robot that is disabled, each camera
+ * processes at most SPECTRUM_IDLE_FPS frames a second (default 30; 0 = off). The frames in between
+ * are never grabbed, so neither the JPEG decode nor the detector runs for them: less power and
+ * heat between matches, and 30 results a second is still plenty to seed the pose before auto. Full
+ * rate again within 5 ms of enable. Off the robot (no NetworkTables connection) nothing changes,
+ * so bench tests and tuning see every frame.
+ *
+ * <p>Also runs a full garbage collection 0.5 s after each enabled-to-disabled transition, so the
+ * heap is clean going into the next match instead of collecting during it.
+ */
+public final class IdleMode {
+    private static final Logger logger = new Logger(IdleMode.class, LogGroup.VisionModule);
+    private static final double IDLE_FPS = readFps();
+    private static final long PERIOD_NANOS = IDLE_FPS > 0 ? (long) (1e9 / IDLE_FPS) : 0;
+    private static volatile boolean listening = false;
+
+    private IdleMode() {}
+
+    private static double readFps() {
+        String env = System.getenv("SPECTRUM_IDLE_FPS");
+        if (env == null || env.isBlank()) return 30;
+        try {
+            return Math.max(0, Double.parseDouble(env.trim()));
+        } catch (NumberFormatException e) {
+            return 30;
+        }
+    }
+
+    /** True while frames should be limited: a robot is connected and disabled. */
+    public static boolean active() {
+        if (PERIOD_NANOS == 0) return false;
+        var ntm = NetworkTablesManager.getInstance();
+        if (!ntm.getNTInst().isConnected()) return false;
+        var ds = ntm.getDriverStation();
+        return ds != null && !ds.current().m_enabled();
+    }
+
+    public static long periodNanos() {
+        return PERIOD_NANOS;
+    }
+
+    /**
+     * Sleeps until {@code lastGrabNanos + period} while idle; returns early (within 5 ms) if the
+     * robot is enabled. Returns false if interrupted.
+     */
+    public static boolean waitForNextFrame(long lastGrabNanos) {
+        startListening();
+        while (active()) {
+            long waitNanos = lastGrabNanos + PERIOD_NANOS - System.nanoTime();
+            if (waitNanos <= 0) break;
+            try {
+                Thread.sleep(Math.max(1, Math.min(5, waitNanos / 1_000_000)));
+            } catch (InterruptedException e) {
+                Thread.currentThread().interrupt();
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static synchronized void startListening() {
+        if (listening) return;
+        var ds = NetworkTablesManager.getInstance().getDriverStation();
+        if (ds == null) return;
+        listening = true;
+        logger.info(
+                IDLE_FPS > 0
+                        ? "Idle mode: " + IDLE_FPS + " fps per camera while the robot is disabled"
+                        : "Idle mode off (SPECTRUM_IDLE_FPS=0)");
+        ds.addTransitionListener(
+                (old, now) -> {
+                    if (old.m_enabled() && !now.m_enabled()) {
+                        var gc =
+                                new Thread(
+                                        () -> {
+                                            try {
+                                                Thread.sleep(500);
+                                            } catch (InterruptedException e) {
+                                                return;
+                                            }
+                                            collect();
+                                        },
+                                        "SpectrumGcWhileDisabled");
+                        gc.setDaemon(true);
+                        gc.start();
+                    }
+                });
+    }
+
+    private static void collect() {
+        var mem = ManagementFactory.getMemoryMXBean();
+        long before = mem.getHeapMemoryUsage().getUsed();
+        long start = System.nanoTime();
+        System.gc();
+        long ms = (System.nanoTime() - start) / 1_000_000;
+        long after = mem.getHeapMemoryUsage().getUsed();
+        logger.info(
+                String.format(
+                        "Robot disabled: garbage collected in %d ms, heap %d -> %d MB",
+                        ms, before >> 20, after >> 20));
+    }
+}
