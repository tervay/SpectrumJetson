+    // SpectrumJetson (photonvision-53): named settings snapshots (Settings > Settings snapshots).
+    private record SnapshotRequest(String name, String id) {}
+
+    private static void snapshotJson(Context ctx, Object body) {
+        try {
+            ctx.contentType("application/json");
+            ctx.result(kObjectMapper.writeValueAsString(body));
+        } catch (JsonProcessingException e) {
+            ctx.status(500);
+        }
+    }
+
+    public static void onSnapshotListRequest(Context ctx) {
+        snapshotJson(ctx, SettingsSnapshots.list());
+    }
+
+    public static void onSnapshotCreateRequest(Context ctx) {
+        try {
+            var req = kObjectMapper.readValue(ctx.body(), SnapshotRequest.class);
+            snapshotJson(ctx, SettingsSnapshots.create(req.name(), "manual"));
+        } catch (IOException e) {
+            ctx.status(500);
+            ctx.result("Couldn't save the snapshot: " + e.getMessage());
+        }
+    }
+
+    public static void onSnapshotRestoreRequest(Context ctx) {
+        try {
+            var req = kObjectMapper.readValue(ctx.body(), SnapshotRequest.class);
+            snapshotJson(ctx, SettingsSnapshots.restore(req.id()));
+        } catch (IOException e) {
+            ctx.status(400);
+            ctx.result("Couldn't restore: " + e.getMessage());
+        }
+    }
+
+    public static void onSnapshotDeleteRequest(Context ctx) {
+        try {
+            var req = kObjectMapper.readValue(ctx.body(), SnapshotRequest.class);
+            SettingsSnapshots.delete(req.id());
+            snapshotJson(ctx, SettingsSnapshots.list());
+        } catch (IOException e) {
+            ctx.status(400);
+            ctx.result("Couldn't delete: " + e.getMessage());
+        }
+    }
+
+    public static void onSnapshotDownloadRequest(Context ctx) {
+        try {
+            String id = ctx.queryParam("id");
+            var zip = SettingsSnapshots.zip(id);
+            ctx.contentType("application/zip");
+            ctx.header("Content-Disposition", "attachment; filename=\"photonvision-snapshot-" + id + ".zip\"");
+            ctx.result(new FileInputStream(zip));
+        } catch (IOException e) {
+            ctx.status(400);
+            ctx.result("Couldn't download: " + e.getMessage());
+        }
+    }
+
     public static void onCopySettingsRequest(Context ctx) {
